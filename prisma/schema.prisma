// Pathfinder battle map — Prisma schema
// Postgres + Driver Adapter (pg) for Next.js 16 Server Actions.
// Connection URL is configured in prisma.config.ts (Prisma 7+).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Scenario {
  id           String   @id @default(cuid())
  name         String
  baseCellSize Int
  width        Int
  height       Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  floors  Floor[]
  effects ScenarioEffect[]
  combat  Combat?
}

model Floor {
  id         String @id @default(cuid())
  scenarioId String
  name       String
  order      Int    @default(0)

  scenario     Scenario         @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  paintedCells PaintedCell[]
  effects      ScenarioEffect[]

  @@index([scenarioId])
}

/// Transient GM-placed effect (burst / cone / line / wall). Persisted to
/// the scenario so a hard reload re-renders the overlay.
///
/// Units (PR 2 of `effects-and-combat-tracker`):
///   - `originCellX` / `originCellY`: anchor in **grid cell coords** of the
///     active subdivision. A value of `1` means cell (1, 1). The canvas hook
///     converts to render pixels via `* activeCellSize`. Stored as `Float` to
///     stay forward-compatible with sub-cell anchors in PR 4.
///   - `widthFt` / `depthFt`: dimensions in **feet** (Pathfinder game rule:
///     1 base cell = 5 ft). The hook converts to active-subdivision cells via
///     `widthFt * cellSizeRatio / FEET_PER_BASE_CELL`.
///   - `rotationDeg`: free rotation in degrees; geometry walkers rotate the
///     direction unit vector before fanning out.
///
/// `durationKind` selects how `remainingRounds` decrements on the `tickRound`
/// op. `expired` flips to true once `remainingRounds` reaches zero and the
/// renderer hides the marker.
model ScenarioEffect {
  id              String   @id @default(cuid())
  scenarioId      String
  floorId         String
  label           String
  kind            String
  originCellX     Float
  originCellY     Float
  widthFt         Float
  depthFt         Float
  rotationDeg     Float    @default(0)
  color           String
  durationKind    String
  remainingRounds Int
  expired         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  floor    Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)

  @@index([scenarioId])
  @@index([floorId])
}

model PaintedCell {
  id            String @id @default(cuid())
  floorId       String
  subdivisionId String
  gridX         Int
  gridY         Int
  pieceId       String
  /// Mutable state attached by traits (e.g. door-states: "open" | "closed" | "locked").
  entityState   Json?

  floor Floor @relation(fields: [floorId], references: [id], onDelete: Cascade)

  @@index([floorId, subdivisionId])
}

/// Active combat session for a scenario. 1:1 with Scenario (one combat at a
/// time per scenario). When combat ends, the cascade delete removes every
/// Combatant row as well — no soft archive (locked decision). `roundNumber` /
/// `currentTurnIndex` are the cursor the client renders in the RoundViewer.
model Combat {
  id               String   @id @default(cuid())
  scenarioId       String   @unique
  roundNumber      Int      @default(1)
  currentTurnIndex Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  scenario   Scenario    @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  combatants Combatant[]

  @@index([scenarioId])
}

/// A single combatant in a Combat. Cascade-deleted when the parent Combat
/// goes (endCombat op). The `initiative` drives turn order; ties are broken
/// by insertion order (the first inserted wins — `id asc` tiebreaker in the
/// read query mirrors this). `position` is a write-time hint only; the read
/// side sorts by `initiative desc`, `id asc` so positions stay gap-tolerant.
model Combatant {
  id         String   @id @default(cuid())
  combatId   String
  name       String
  initiative Int
  side       String // 'players' | 'enemies' | 'neutral'
  position   Int // explicit ordering field (best-effort, recomputed on add)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  combat Combat @relation(fields: [combatId], references: [id], onDelete: Cascade)

  @@index([combatId])
  @@index([combatId, position])
}

