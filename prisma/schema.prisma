// Pathfinder battle map — Prisma schema
// Postgres + Driver Adapter (pg) for Next.js 16 Server Actions.
// Connection URL is configured in prisma.config.ts (Prisma 7+).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Scenario {
  id           String   @id @default(cuid())
  name         String
  baseCellSize Int
  width        Int
  height       Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  floors Floor[]
}

model Floor {
  id         String @id @default(cuid())
  scenarioId String
  name       String
  order      Int    @default(0)

  scenario     Scenario      @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  paintedCells PaintedCell[]

  @@index([scenarioId])
}

model PaintedCell {
  id            String @id @default(cuid())
  floorId       String
  subdivisionId String
  gridX         Int
  gridY         Int
  pieceId       String
  /// Mutable state attached by traits (e.g. door-states: "open" | "closed" | "locked").
  entityState   Json?

  floor Floor @relation(fields: [floorId], references: [id], onDelete: Cascade)

  @@index([floorId, subdivisionId])
}

model SubdivisionConfig {
  id            String @id @default(cuid())
  name          String
  pieceIds      String @default("[]")
  cellSizeRatio Int
  order         Int    @default(0)

  @@index([order])
}

