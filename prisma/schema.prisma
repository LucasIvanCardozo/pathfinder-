// Pathfinder battle map — Prisma schema
// Postgres + Driver Adapter (pg) for Next.js 16 Server Actions.
// Connection URL is configured in prisma.config.ts (Prisma 7+).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Scenario {
  id           String   @id @default(cuid())
  name         String
  baseCellSize Int
  width        Int
  height       Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  floors  Floor[]
  effects ScenarioEffect[]
  combat  Combat?
}

model Floor {
  id         String @id @default(cuid())
  scenarioId String
  name       String
  order      Int    @default(0)

  scenario     Scenario         @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  paintedCells PaintedCell[]
  effects      ScenarioEffect[]

  @@index([scenarioId])
}

/// A GM-cast spell (PR 1 of the spellcasting refactor).
///
/// Shape, dimensions, and colour are resolved at read time from the
/// hardcoded `SPELL_TEMPLATES` array (see `src/canvas/effects/spell-templates.ts`)
/// keyed by `templateId`; the row stores only the *instance* data the GM
/// chose when casting:
///
///   - `templateId`: which of the five hardcoded spells (e.g. `cone-15`,
///     `radius-10`).
///   - `originCellX` / `originCellY`: anchor in integer **grid cell coords**
///     of the active subdivision.
///   - `rotationIndex`: 0..7. Even indices pick the cardinal matrix, odd
///     indices pick the diagonal matrix; `Math.floor(rotationIndex / 2)` is the
///     quarter-turn within each orientation. Cones use it; circles repeat
///     the same matrix on both slots so the index is a visual no-op for them.
///   - `durationRounds`: PF1e-style lifetime in world rounds. The server
///     decrements it on every `nextTurn` / `advanceRound` op and deletes
///     the row when it hits zero in the same TX (PF1e duration rule —
///     a spell dies N rounds of the world after casting, not on the
///     caster's next turn). Default 1 preserves the legacy one-round
///     behaviour for existing rows.
///   - `casterCombatantId` + `castOnTurnIndex` + `castOnRoundNumber`:
///     combat-cursor snapshot at cast time. Now metadata only: the expiry
///     rule does not consult `casterCombatantId` anymore. The snapshot
///     is still persisted for the read-side orphan cleanup (`caster`
///     SetNull semantics) and for future "who cast what" auditing.
///     `casterCombatantId` is nullable so removing the caster mid-spell
///     cascades to SetNull rather than deleting the row (an orphan
///     marker is shown until the GM removes it manually).
model ScenarioEffect {
  id                String   @id @default(cuid())
  scenarioId        String
  floorId           String
  templateId        String
  originCellX       Int
  originCellY       Int
  rotationIndex     Int      @default(0)
  durationRounds    Int      @default(1)
  casterCombatantId String?
  castOnTurnIndex   Int
  castOnRoundNumber Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  scenario Scenario   @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  floor    Floor      @relation(fields: [floorId], references: [id], onDelete: Cascade)
  caster   Combatant? @relation(fields: [casterCombatantId], references: [id], onDelete: SetNull)

  @@index([scenarioId])
  @@index([floorId])
  @@index([casterCombatantId])
}

model PaintedCell {
  id            String @id @default(cuid())
  floorId       String
  subdivisionId String
  gridX         Int
  gridY         Int
  pieceId       String
  /// Mutable state attached by traits (e.g. door-states: "open" | "closed" | "locked").
  entityState   Json?

  floor Floor @relation(fields: [floorId], references: [id], onDelete: Cascade)

  @@index([floorId, subdivisionId])
}

/// Active combat session for a scenario. 1:1 with Scenario (one combat at a
/// time per scenario). When combat ends, the cascade delete removes every
/// Combatant row as well — no soft archive (locked decision). `roundNumber` /
/// `currentTurnIndex` are the cursor the client renders in the RoundViewer.
model Combat {
  id               String   @id @default(cuid())
  scenarioId       String   @unique
  roundNumber      Int      @default(1)
  currentTurnIndex Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  scenario   Scenario    @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  combatants Combatant[]

  @@index([scenarioId])
}

/// A single combatant in a Combat. Cascade-deleted when the parent Combat
/// goes (endCombat op). The `initiative` drives turn order; ties are broken
/// by insertion order (the first inserted wins — `id asc` tiebreaker in the
/// read query mirrors this). `position` is a write-time hint only; the read
/// side sorts by `initiative desc`, `id asc` so positions stay gap-tolerant.
model Combatant {
  id         String   @id @default(cuid())
  combatId   String
  name       String
  initiative Int
  side       String // 'players' | 'enemies' | 'neutral'
  position   Int // explicit ordering field (best-effort, recomputed on add)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  combat  Combat           @relation(fields: [combatId], references: [id], onDelete: Cascade)
  effects ScenarioEffect[]

  @@index([combatId])
  @@index([combatId, position])
}

