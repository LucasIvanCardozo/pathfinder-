# Copy this file to `.env` (local) or `.env.production` (prod) and fill in real values.
# `.env.example` is the only env file versioned in git; real env files are gitignored.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pathfinder"

# Password gate for the editor. Without a valid password, the editor is
# unreachable (home page stays public so the list of scenarios is visible).
EDITOR_PASSWORD=
# HMAC secret used to sign the session cookie. Must be a long random string.
# Run: openssl rand -hex 32
EDITOR_SECRET=
