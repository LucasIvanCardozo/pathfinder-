{
  "name": "pathfinder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "check": "biome check --write",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules .next",
    "gen-cat": "tsx src/assets/scripts/generate-catalog.ts",
    "db:reset": "dotenv -e .env -- prisma migrate reset --force && dotenv -e .env -- prisma generate",
    "db:pr:reset": "dotenv -e .env.production -- prisma migrate reset --force && dotenv -e .env.production -- prisma generate",
    "db:migrate:local": "dotenv -e .env -- prisma migrate dev && dotenv -e .env -- prisma db seed",
    "db:migrate:prod": "dotenv -e .env.production -- prisma migrate deploy",
    "db:studio:local": "dotenv -e .env -- prisma studio",
    "db:studio:prod": "dotenv -e .env.production -- prisma studio",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@hookform/resolvers": "^3.10.0",
    "konva": "^9.3.18",
    "next": "^16.0.0",
    "pg": "^8.13.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.0",
    "react-hot-toast": "^2.6.0",
    "react-konva": "^19.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "image-size": "^1.1.1",
    "prisma": "^7.9.0",
    "sharp": "^0.33.5",
    "svgo": "^3.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  }
}
